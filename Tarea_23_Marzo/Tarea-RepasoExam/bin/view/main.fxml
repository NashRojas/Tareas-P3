<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.MainController">
   <top>
      <MenuBar BorderPane.alignment="CENTER">
        <menus>
          <Menu mnemonicParsing="false" text="File">
            <items>
              <MenuItem mnemonicParsing="false" text="Close" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Edit">
            <items>
              <MenuItem mnemonicParsing="false" text="Delete" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Help">
            <items>
              <MenuItem mnemonicParsing="false" text="About" />
            </items>
          </Menu>
        </menus>
      </MenuBar>
   </top>
   <center>
      <TableView fx:id="tablaProductos" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="colNombre" prefWidth="75.0" text="Nombre" />
          <TableColumn fx:id="colCategoria" prefWidth="75.0" text="Categoria" />
            <TableColumn fx:id="colPrecio" prefWidth="75.0" text="Precio" />
            <TableColumn fx:id="colCantidad" prefWidth="75.0" text="Cantidad" />
        </columns>
      </TableView>
   </center>
   <bottom>
      <VBox id="vboxx" prefHeight="165.0" prefWidth="600.0" spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="lblEstado" prefHeight="17.0" prefWidth="30.0" text="Listo" />
            <HBox alignment="CENTER" prefHeight="43.0" prefWidth="600.0" spacing="10.0">
               <children>
                  <Button fx:id="btnAgregar" mnemonicParsing="false" onAction="#abrirFormulario" prefHeight="25.0" prefWidth="122.0" text="Agregar" />
                  <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#eliminarProducto" text="Eliminar" />
                  <Button fx:id="btnGuardar" mnemonicParsing="false" text="Guardar" />
                  <Button fx:id="btnCargar" alignment="CENTER" mnemonicParsing="false" text="Cargar" />
               </children>
            </HBox>
            <ProgressBar fx:id="progressBar" prefHeight="21.0" prefWidth="600.0" progress="0.0" />
         </children>
      </VBox>
   </bottom>
</BorderPane>
