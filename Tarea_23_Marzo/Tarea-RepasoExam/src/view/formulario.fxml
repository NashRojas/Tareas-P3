            <TextField fx:id="txtPrecio" prefHeight="36.0" prefWidth="600.0" promptText="Precio" />
            <TextField fx:id="txtCantidad" prefHeight="35.0" prefWidth="600.0" promptText="Cantidad" />
         </children>
      </VBox>
   </center>
   <bottom>
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="15.0" BorderPane.alignment="CENTER">
